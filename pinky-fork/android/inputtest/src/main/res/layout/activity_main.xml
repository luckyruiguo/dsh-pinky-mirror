<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pinky input test"
            android:textAppearance="@android:style/TextAppearance.DeviceDefault.Large" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:labelFor="@+id/plain"
            android:text="Ordinary field" />

        <EditText
            android:id="@+id/plain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="EditText"
            android:imeOptions="actionDone"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@+id/no_set_text"
            android:text="Field without ACTION_SET_TEXT" />

        <app.pinky.inputtest.NoSetTextEditText
            android:id="@+id/no_set_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="EditText that refuses ACTION_SET_TEXT"
            android:imeOptions="actionSend"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@+id/no_commit"
            android:text="Field that only takes a paste" />

        <app.pinky.inputtest.NoCommitEditText
            android:id="@+id/no_commit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="EditText that drops committed text"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Chat input (custom view and InputConnection)" />

        <app.pinky.inputtest.ChatInput
            android:id="@+id/chat"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#FFEEEEEE"
            android:contentDescription="Chat input" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@+id/short_field"
            android:text="Field of at most 4 characters" />

        <EditText
            android:id="@+id/short_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="maxLength 4"
            android:inputType="text"
            android:maxLength="4" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Field that takes no text" />

        <app.pinky.inputtest.DeadInput
            android:id="@+id/dead"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#FFEEEEEE"
            android:contentDescription="Dead input" />

        <TextView
            android:id="@+id/echo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textIsSelectable="false" />
    </LinearLayout>
</ScrollView>
